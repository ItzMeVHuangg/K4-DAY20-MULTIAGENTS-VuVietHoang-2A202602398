# Copy this file to .env and fill in the values. NEVER commit .env.
# Option 1 - Azure OpenAI or an OpenAI-compatible gateway (give all three):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_MODEL=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview   # only for real *.openai.azure.com endpoints

# Option 2 - another provider (leave Option 1 empty):
# LAB_MODEL=deepseek:deepseek-chat
# DEEPSEEK_API_KEY=

# Option 3 - Gemini free tier (AI Studio key). <= 14 requests/minute, ~225K tokens/minute and 499 requests/day per model are enforced by
# src/lab/gemini.py; when a model's daily quota is used up the next model of the chain is used.
# LAB_MODEL=google_genai:gemini-3.5-flash-lite
# GOOGLE_API_KEY=
# LAB_FALLBACK_MODELS=gemini-3.1-flash-lite

LAB_TEMPERATURE=0
